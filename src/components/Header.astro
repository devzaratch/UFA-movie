---
import { movieDatabase } from '../data/movies.js';

interface Props {
    total?: number;  // show the top notice bar with entry count
    active?: string; // which nav link to highlight (unused visually for now)
}

const { total = null, active = '' } = Astro.props;
const navItems = [
    { label: 'หน้าแรก', href: '/', active: active === 'home' },
    { label: 'หนังใหม่ 2025', href: '/?year=2025' },
    { label: 'หนังใหม่ 2024', href: '/?year=2024' },
    { label: 'ຊີລີ່ອອນໄລນ໌ (ซีรีย์)', cat: 'serie' },
    { label: 'หนังแอ็คชั่น', cat: 'action' },
    { label: 'หนังผี สยองขวัญ', cat: 'horror' },
    { label: 'การ์ตูน', cat: 'anime' },
    { label: 'ດຣາມ່າ (Drama)', cat: 'drama' },
];
---

{total !== null && (
    <div class="notice">ดูหนังออนไลน์ฟรี DOONUNG-MOVIE มีหนังและซีรีส์ทั้งหมด {total} ເລື່ອງ ອັບເດດໜັງໃຝ່ທຸກວັນ.</div>
)}

<header class="header">
    <a href="/" class="logo">
        <img src="/favicon.png" alt="DOONUNG-MOVIE" loading="eager" />
    </a>
    <form class="search-box" onsubmit="return false;">
        <input type="text" id="search" placeholder="พิมพ์ชื่อหนัง... ຄົ້ນຫາໜັງ" onkeyup="doSearch()" />
        <button type="submit" class="search-btn" onclick="doSearch()" aria-label="ค้นหา"><i class="fas fa-search"></i></button>
    </form>
    <div class="social-icons">
        <a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
        <a href="#" aria-label="Line"><i class="fab fa-line"></i></a>
    </div>
</header>

<nav class="mainnav">
    {navItems.map(item => (
        item.href
            ? <a href={item.href} class={item.active ? 'active' : ''}>{item.label}</a>
            : <a onclick={`window.filter('${item.cat}')`}>{item.label}</a>
    ))}
</nav>
