---
import { movieDatabase } from '../data/movies.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { slugify, yearOf } from '../lib/slug.js';

const entries = movieDatabase.map(m => ({ ...m, slug: slugify(m.id, m.title), year: yearOf(m.title) }));

const CATEGORY_LABEL = {
    action: 'ໜັງແອັກຊັນ (Action)',
    horror: 'ໜັງຜີ (Horror)',
    anime: 'ກາຕູນ (Anime)',
    serie: 'ຊີລີ້ (Series)',
    drama: 'ດຣາມ່າ (Drama)',
};
const catLabel = c => CATEGORY_LABEL[c] || '';
---

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>DOONUNG-MOVIE ເບິ່ງໜັງອອນໄລນ໌ຟຣີ ดูหนังออนไลน์ฟรี หนังใหม่ 2025 HD</title>
    <meta name="description" content="DOONUNG-MOVIE ເວັບເບິ່ງໜັງອອນໄລນ໌ຟຣີ ລວມໜັງໃຝ່ 2025 ຄົມຊັດລະດັບ HD ເຕັມເລື່ອງ ມີທັງໜັງແອັກຊັນ ໜັງຜີ ໜັງຮັກ ແລະ ກາຕູນ ອັບເດດໃໝ່ທຸກມື້" />
    <meta name="keywords" content="ເບິ່ງໜັງອອນໄລນ໌, ໜັງໃຝ່ 2025, ເບິ່ງໜັງຟຣີ, DOONUNG-MOVIE, ดูหนังออนไลน์, หนังใหม่ 2025, ดูหนังฟรี" />

    <meta property="og:title" content="DOONUNG-MOVIE | ເບິ່ງໜັງອອນໄລນ໌ຟຣີ 2025" />
    <meta property="og:description" content="ລວມໜັງໃຝ່ຊົນໂຮງ ແລະ ຊີລີ້ດັງ ພາກໄທ HD" />
    <meta property="og:image" content="/favicon.png" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
        :root {
            --gold: #ffcf18;
            --gold-soft: #ffc900;
            --imdb-bar: #f0d78c;
            --bg: #000;
            --panel: #0d0d0d;
            --border: #262626;
            --ribbon: #e50914;
        }
        * { box-sizing: border-box; }
        body { background: var(--bg); color: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 16px; margin: 0; }

        .notice { background: #161004; border-bottom: 1px solid var(--border); color: var(--gold); font-size: 13px; font-weight: bold; padding: 8px 5%; text-align: center; }

        .header { background: var(--bg); padding: 14px 3% 10px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 25px; position: relative; }
        .logo img { height: 64px; display: block; }
        .search-box { position: relative; width: 100%; max-width: 430px; flex: 1; }
        .search-box input { width: 100%; height: 38px; border-radius: 20px; border: none; background: #fff; color: #242424; font-size: 12px; padding: 0 52px 0 18px; outline: none; }
        .search-btn { position: absolute; right: 4px; top: 4px; width: 30px; height: 30px; border-radius: 50%; border: none; background: var(--bg); color: #fff; cursor: pointer; }
        .social-icons { display: flex; gap: 14px; }
        .social-icons a { color: #ccc; font-size: 20px; text-decoration: none; }
        .social-icons a:hover { color: var(--gold); }

        .mainnav { border-bottom: 1px solid var(--border); padding: 10px 3%; display: flex; flex-wrap: wrap; gap: 8px 34px; }
        .mainnav a { color: #f0f0f0; font-family: 'Oswald', Arial, Helvetica, sans-serif; font-size: 19px; text-decoration: none; cursor: pointer; }
        .mainnav a:hover, .mainnav a.active { color: var(--gold); }

        .wrap { padding: 15px 3%; }
        .top-slider { display: flex; gap: 12px; overflow-x: auto; padding: 10px 2px; scrollbar-width: thin; }
        .top-slider li { list-style: none; flex: 0 0 155px; cursor: pointer; }
        .top-slider img { width: 155px; height: 205px; object-fit: cover; object-position: center; display: block; border: 2px solid #1c1c1c; }
        .top-slider img:hover { border-color: var(--gold); }

        .layout { display: flex; gap: 18px; margin-top: 15px; }
        .content { flex: 1; min-width: 0; }
        .sidebar { width: 310px; flex-shrink: 0; }

        .seo-box { margin: 10px 0 20px; }
        .seo-box h1 { background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--gold); color: var(--gold); font-size: 19px; margin: 0 0 12px; padding: 10px 14px; }
        .seo-box p { color: var(--gold-soft); font-size: 13px; line-height: 1.9; margin: 8px 0; }
        .seo-box strong { color: var(--gold); }

        .movie-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
        .card { width: 216px; background: #fff; cursor: pointer; position: relative; overflow: hidden; }
        .card img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; display: block; }
        .ribbon { position: absolute; top: 6px; right: -30px; transform: rotate(45deg); background: var(--ribbon); color: #fff; font-size: 11px; font-weight: bold; padding: 3px 34px; z-index: 5; box-shadow: 0 1px 3px rgba(0,0,0,.5); }
        .rating-bar { background: var(--imdb-bar); color: #222; font-size: 12px; font-weight: bold; text-align: center; padding: 5px 4px; }
        .card-title { color: #000; font-size: 14px; font-weight: bold; text-align: center; padding: 8px 6px 10px; min-height: 58px; display: flex; align-items: center; justify-content: center; }

        #pagination { display: flex; justify-content: center; gap: 6px; margin: 28px 0; flex-wrap: wrap; }
        #pagination button { background: var(--panel); border: 1px solid var(--border); border-radius: 3px; color: #ccc; cursor: pointer; font-size: 13px; padding: 6px 12px; }
        #pagination button.cur { background: var(--gold); border-color: var(--gold); color: #000; font-weight: bold; }

        .side-box { background: var(--panel); border: 1px solid var(--border); margin-bottom: 16px; }
        .side-title { background: var(--gold); color: #000; font-family: 'Oswald', Arial, Helvetica, sans-serif; font-size: 15px; font-weight: 600; letter-spacing: .5px; padding: 9px 12px; }
        .side-list { list-style: none; margin: 0; padding: 0; }
        .side-list li { border-bottom: 1px solid #1a1a1a; }
        .side-list li:last-child { border-bottom: none; }
        .side-list a { color: #ccc; cursor: pointer; display: flex; gap: 10px; align-items: center; font-size: 13px; padding: 8px 12px; text-decoration: none; transition: .2s; }
        .side-list a:hover { background: #191919; color: var(--gold); padding-left: 18px; }
        .side-list img { width: 36px; height: 54px; object-fit: cover; flex-shrink: 0; }
        .side-promo { background: linear-gradient(135deg, #1a1204, #342305); border: 1px solid var(--gold); color: var(--gold); display: block; font-weight: bold; padding: 18px 14px; text-align: center; text-decoration: none; font-size: 15px; }
        .side-promo span { display: block; font-size: 12px; color: #ddd; margin-top: 6px; }

        #footborder { border-top: 3px solid var(--gold); }
        .footer-seo { background: var(--bg); color: #999; font-size: 12px; line-height: 1.9; padding: 28px 5% 40px; }
        .footer-seo a { color: var(--gold); text-decoration: none; margin-right: 12px; cursor: pointer; }
        .footer-seo a:hover { text-decoration: underline; }
        .footer-seo .copy { border-top: 1px solid var(--border); margin-top: 20px; padding-top: 15px; text-align: center; }

        @media (max-width: 900px) {
            .sidebar { display: none; }
            .mainnav { gap: 8px 18px; }
            .mainnav a { font-size: 16px; }
        }
    </style>
</head>
<body>

    <Header total={movieDatabase.length} active="home" />

    <div class="wrap">
        <ul class="top-slider">
            {entries.slice(0, 28).map(m => (
                <li><a href={`/movie/${m.slug}/`}><img src={m.poster} alt={`${m.title} DOONUNG-MOVIE`} loading="eager" /></a></li>
            ))}
        </ul>

        <div class="layout">
            <div class="content">
                <div class="seo-box">
                    <h1>DOONUNG-MOVIE ‌ເບິ່ງໜັງອອນໄລນ໌ຟຣີ ดูหนังออนไลน์ฟรี ລວມໜັງໃຝ່ 2025 HD ພາກໄທ ເຕັມເລື່ອງ</h1>
                    <p>
                        <strong>DOONUNG-MOVIE</strong> ຍິນດີຕ້ອນຮັບສູ່ ເວັບເບິ່ງໜັງອອນໄລນ໌ທີ່ດີທີ່ສຸດ. ເຮົາຄືແຫຼ່ງຮວມ
                        <strong>ໜັງໃຝ່ຊົນໂຮງ 2025</strong> ແລະ ຊີລີ້ດັງຈາກທົ່ວໂລກ ຄົມຊັດລະດັບ 4K ແລະ HD
                        ພາກໄທ ເຕັມເລື່ອງ ເບິ່ງຟຣີບໍ່ມີຄ່າບໍລິການ ອັບເດດໜັງໃຝ່ໃນທຸກມື້.
                    </p>
                    <p>
                        • <strong>ມີຄັບໝວດທຸກທີ່ຢາກເບິ່ງ:</strong> ໜັງແອັກຊັນ ໜັງຜີ ສະຫຍອງຂວັນ ກາຕູນອານິເມະ ດຣາມ່າຮັກ
                        ແລະ ຊີລີ້ດັງ ພາກໄທ ພາກຊັບ ພາກອັງກິດ ຮອງຮັບການເບິ່ງທັງຜ່ານມືຖື ແລະ ຄອມພິວເຕີ.
                    </p>
                    <p>
                        • <strong>ອັບເດດທຸກມື້ ບໍ່ໃຫ້ພົ້ນທຸກແນວ:</strong> ໜັງຖືກຈັດກຸ່ມເປັນໝວດຫມວດຶດຕາມປີທີ່ອອກສະຫຍາຍ
                        ຊອກຫາໜັງໄດ້ງ່າຍຈາກຄອກສີສັນ ຫຼື ຂຽນຊື່ໜັງທີ່ຢາກເບິ່ງ ໃນກ່ອງຄັນຄາໂຍນ.
                    </p>
                </div>

                <div class="movie-grid" id="grid">
                    {entries.map(m => (
                        <a class="card" href={`/movie/${m.slug}/`}
                            data-title={m.title.toLowerCase()} data-cat={m.category} data-year={m.year ?? ''}>
                            <div class="ribbon">{m.quality || 'HD'}</div>
                            <img src={m.poster} alt={`${m.title} ເບິ່ງໜັງອອນໄລນ໌ຟຣີ DOONUNG-MOVIE`} loading="lazy" />
                            <div class="rating-bar">{m.rating ? `ເບິ່ງໜັງອອນໄລນ໌ IMDb: ${m.rating}` : catLabel(m.category)}</div>
                            <div class="card-title">{m.title}</div>
                        </a>
                    ))}
                </div>
                <div id="pagination"></div>
            </div>

            <aside class="sidebar">
                <div class="side-box">
                    <div class="side-title">ເລື່ອງລ້າສຸດ (ล่าสุด)</div>
                    <ul class="side-list">
                        {entries.slice(0, 12).map(m => (
                            <li><a href={`/movie/${m.slug}/`}>
                                <img src={m.poster} alt={m.title} loading="lazy" /> <span>{m.title}</span>
                            </a></li>
                        ))}
                    </ul>
                </div>
                <div class="side-box">
                    <div class="side-title">ໝວດໝູ່ (หมวดหมู่)</div>
                    <ul class="side-list">
                        <li><a onclick="window.filter('all')">ທັງໝົດ (ทั้งหมด)</a></li>
                        <li><a onclick="window.filter('action')">ແອັກຊັນ (Action)</a></li>
                        <li><a onclick="window.filter('horror')">ໜັງຜີ (Horror)</a></li>
                        <li><a onclick="window.filter('anime')">ອານິເມະ (Anime)</a></li>
                        <li><a onclick="window.filter('serie')">ຊີລີ້ (Series)</a></li>
                        <li><a onclick="window.filter('drama')">ດຣາມ່າ (Drama)</a></li>
                    </ul>
                </div>
                <a class="side-promo" href="https://ufasboclubauto.com/register" target="_blank">
                    ສະໝັກສະມາຊິກ (สมัครสมาชิก)
                    <span>ຮັບໜັງຄົມຊັດ HD ພາກໄທ ເຕັມເລື່ອງ ທຸກຮູບແບບ</span>
                </a>
            </aside>
        </div>
    </div>

    <Footer />

    {/* All cards are rendered at build time; this script only paginates / filters them client-side. */}
    <script is:inline>
        (function () {
            const cards = Array.from(document.querySelectorAll('#grid .card'));
            const perPage = 18;
            let cur = 1;
            let list = cards.slice();

            function page() {
                list.forEach(c => (c.style.display = 'none'));
                list.slice((cur - 1) * perPage, cur * perPage).forEach(c => (c.style.display = ''));
                const totalPages = Math.max(1, Math.ceil(list.length / perPage));
                const box = document.getElementById('pagination');
                if (totalPages <= 1) { box.innerHTML = ''; return; }
                let html = '';
                for (let i = 1; i <= totalPages; i++) {
                    html += '<button class="' + (i === cur ? 'cur' : '') + '" data-page="' + i + '">' + i + '</button>';
                }
                box.innerHTML = html;
                box.querySelectorAll('button').forEach(b => {
                    b.onclick = () => { cur = parseInt(b.dataset.page, 10); page(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
                });
            }

            window.doSearch = function () {
                const val = document.getElementById('search').value.toLowerCase();
                list = val ? cards.filter(c => c.dataset.title.includes(val)) : cards.slice();
                cur = 1; page();
            };

            window.filter = function (c) {
                list = (c === 'all') ? cards.slice() : cards.filter(x => x.dataset.cat === c);
                cur = 1; page();
            };

            // Year filter from ?year=YYYY (nav "หนังใหม่ 2025/2024"); year comes from the title at build time
            const urlYear = new URLSearchParams(window.location.search).get('year');
            if (urlYear) {
                list = cards.filter(c => c.dataset.year === urlYear);
                window.scrollTo(0, 0);
            }
            page();
        })();
    </script>
</body>
</html>
